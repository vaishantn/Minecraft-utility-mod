			"net.prodragon.utilitymod.UtilityMod"
		],
		"fabric-datagen": [
			"net.prodragon.utilitymod.UtilityModDataGenerator"
		]
	},
	"mixins": [
		"utilitymod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
